<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/color_cream"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="#1F2A7B76"
    app:strokeColor="@color/color_sage"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Barra lateral de acento clínico (cambia de color dinámicamente) -->
        <View
            android:id="@+id/viewBarraCategoria"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/color_teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Fila superior: Badge de categoría + Botón eliminar en burbuja -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTipoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_vacuna"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="VACUNA"
                    android:textColor="@color/color_pine"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_rose"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/btnEliminarSaludRecord"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="@color/color_rose" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Título / Descripción principal -->
            <TextView
                android:id="@+id/tvDescripcionSalud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Descripción"
                android:textColor="@color/color_pine"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                app:dividerColor="@color/color_sage" />

            <!-- Fila de fechas lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFechaAplicacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:text="Aplicado: 01/01/2026"
                    android:textColor="@color/color_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@android:drawable/ic_menu_day"
                    app:drawableTint="@color/color_teal" />

                <TextView
                    android:id="@+id/tvFechaProximo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="⏰ Próximo: 01/02/2026"
                    android:textColor="@color/color_rose"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Botón rápido para marcar recordatorio pendiente como aplicado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompletarRecordatorio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:text="✓ Marcar como aplicado hoy"
                android:textAllCaps="false"
                android:textColor="@color/color_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="19dp"
                app:strokeColor="@color/color_teal" />

            <!-- Caja de notas médicas -->
            <TextView
                android:id="@+id/tvNotasSalud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_consulta"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Notas: ..."
                android:textColor="@color/color_pine"
                android:textSize="12sp"
                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>